# Backend (FastAPI) environment variables. Copy to .env for local development;
# set the same keys as environment variables on Render in production.

# Postgres connection string. In production use the Supabase *session pooler* URL
# (host ...pooler.supabase.com, user postgres.<project-ref>).
DATABASE_URL=postgresql://username:password@localhost:5432/seatstalker

# Secret used to sign login JWTs (HS256). Generate a long random value.
JWT_SECRET=replace-with-a-long-random-string

# Resend API key and verified sender address for OTP / password-reset emails.
# If either is unset, emails are printed to the console instead (handy locally).
RESEND_API_KEY=re_your_resend_api_key
RESEND_SENDER_EMAIL=alerts@yourdomain.com

# Frontend origin(s) allowed by CORS and used in password-reset links.
# Comma-separate multiple origins. http://localhost:5173 is always allowed.
FRONTEND_URL=http://localhost:5173

# UMD Testudo term code used for course search (e.g. 202701 = Spring 2027).
UMD_SEMESTER=202701

# Optional: regex of extra allowed CORS origins (e.g. Vercel preview deployments).
# CORS_ORIGIN_REGEX=https://your-project-[a-z0-9-]+\.vercel\.app

# Optional: password-reset link lifetime in minutes (default 15).
# PASSWORD_RESET_TTL_MINUTES=15
